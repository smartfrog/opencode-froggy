{
  "name": "opencode-froggy",
  "version": "1.6.2",
  "description": "OpenCode plugin for multi-agent orchestration, durable project memory, and general-purpose tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./tui.ts",
      "types": "./tui.ts"
    }
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "agent",
    "command",
    "skill",
    "tui.ts",
    "images",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "code-review",
    "code-simplification",
    "ai-agent",
    "llm",
    "automation",
    "developer-tools",
    "cli"
  ],
  "author": "Fred",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartfrog/opencode-froggy"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.5",
    "js-yaml": "^4.1.0",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.0"
  }
}
